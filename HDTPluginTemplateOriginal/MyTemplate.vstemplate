<VSTemplate Version="3.0.0" xmlns="http://schemas.microsoft.com/developer/vstemplate/2005" Type="Project">
  <TemplateData>
    <Name>HDTPluginTemplate</Name>
    <Description>A Template to help jumpstart your creation of an Hearthstone Deck Tracker Plugin</Description>
    <ProjectType>CSharp</ProjectType>
    <LanguageTag>xaml</LanguageTag>
    <LanguageTag>csharp</LanguageTag>
    <PlatformTag>windows</PlatformTag>
    <ProjectSubType>
    </ProjectSubType>
    <SortOrder>1000</SortOrder>
    <CreateNewFolder>true</CreateNewFolder>
    <DefaultName>HDTPluginTemplate</DefaultName>
    <ProvideDefaultName>true</ProvideDefaultName>
    <LocationField>Enabled</LocationField>
    <EnableLocationBrowseButton>true</EnableLocationBrowseButton>
    <Icon>__TemplateIcon.ico</Icon>
  </TemplateData>
  <TemplateContent>
    <Project TargetFileName="PluginTemplate.csproj" File="PluginTemplate.csproj" ReplaceParameters="true">
      <ProjectItem ReplaceParameters="true" TargetFileName="App.config">App.config</ProjectItem>
      <Folder Name="Controls" TargetFolderName="Controls">
        <ProjectItem ReplaceParameters="true" TargetFileName="PlugInDisplayControl.xaml">PlugInDisplayControl.xaml</ProjectItem>
        <ProjectItem ReplaceParameters="true" TargetFileName="PlugInDisplayControl.xaml.cs">PlugInDisplayControl.xaml.cs</ProjectItem>
        <ProjectItem ReplaceParameters="true" TargetFileName="SettingsView.xaml">SettingsView.xaml</ProjectItem>
        <ProjectItem ReplaceParameters="true" TargetFileName="SettingsView.xaml.cs">SettingsView.xaml.cs</ProjectItem>
      </Folder>
      <ProjectItem ReplaceParameters="true" TargetFileName="HDTBootstrap.cs">HDTBootstrap.cs</ProjectItem>
      <Folder Name="libs" TargetFolderName="libs">
        <ProjectItem ReplaceParameters="false" TargetFileName="HearthDb.dll">HearthDb.dll</ProjectItem>
        <ProjectItem ReplaceParameters="false" TargetFileName="HearthstoneDeckTracker.exe">HearthstoneDeckTracker.exe</ProjectItem>
      </Folder>
      <Folder Name="Logic" TargetFolderName="Logic">
        <ProjectItem ReplaceParameters="true" TargetFileName="InputMoveManager.cs">InputMoveManager.cs</ProjectItem>
        <ProjectItem ReplaceParameters="true" TargetFileName="LocalizeTools.cs">LocalizeTools.cs</ProjectItem>
      </Folder>
      <ProjectItem ReplaceParameters="true" TargetFileName="MyPlugin.cs">MyPlugin.cs</ProjectItem>
      <Folder Name="Properties" TargetFolderName="Properties">
        <ProjectItem ReplaceParameters="true" TargetFileName="AssemblyInfo.cs">AssemblyInfo.cs</ProjectItem>
        <ProjectItem ReplaceParameters="true" TargetFileName="Settings.settings">Settings.settings</ProjectItem>
        <ProjectItem ReplaceParameters="true" TargetFileName="Settings.Designer.cs">Settings.Designer.cs</ProjectItem>
      </Folder>
      <ProjectItem ReplaceParameters="false" TargetFileName="ReadMe.md" OpenInEditor="true">ReadMe.md</ProjectItem>
      <Folder Name="Resources" TargetFolderName="Resources">
        <ProjectItem ReplaceParameters="true" TargetFileName="StringsResource.resx">StringsResource.resx</ProjectItem>
        <ProjectItem ReplaceParameters="true" TargetFileName="StringsResource.Designer.cs">StringsResource.Designer.cs</ProjectItem>
      </Folder>
    </Project>
  </TemplateContent>
</VSTemplate>