<Window x:Class="HDTPlugin.DebugWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:HDTPlugin.Controls"
        Title="HDTPlugin Debug Window"
        Height="600" Width="1280"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Image x:Name="BackgroundImage" Stretch="UniformToFill"/>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Plugin Display - positioned as in-game -->
            <Canvas x:Name="PluginCanvas">
                <controls:PlugInDisplayControl x:Name="DisplayControl"/>
            </Canvas>
            
            <!-- Debug Controls - centered -->
            <Border Grid.Row="1" Grid.Column="1" 
                Background="#AA000000" 
                BorderBrush="Gray" BorderThickness="1" 
                Padding="10" Margin="350,0,0,0"
                CornerRadius="5">
                <ScrollViewer MaxHeight="500" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Debug Window" FontSize="16" FontWeight="Bold" Margin="0,0,0,10" Foreground="White"/>
                        <Button Name="BtnToggleDrag" Content="Toggle Dragging" Margin="0,0,0,10" Click="BtnToggleDrag_Click"/>
                        <Border BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Mock Counters" FontWeight="Bold" Margin="0,0,0,5" Foreground="White"/>
                                <Button Name="BtnReset" Content="Reset All" Margin="0,5,0,5" Click="BtnReset_Click"/>
                                
                                <!-- Minions Played -->
                                <Grid Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Minions Played:" VerticalAlignment="Center" Foreground="White"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="-10" Width="35" Click="BtnMinionsSub10_Click"/>
                                        <Button Content="-1" Width="30" Click="BtnMinionsSub1_Click" Margin="2,0,0,0"/>
                                        <TextBlock x:Name="TxtMinions" Text="0" Width="30" TextAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                                        <Button Content="+1" Width="30" Click="BtnMinionsAdd1_Click" Margin="2,0,0,0"/>
                                        <Button Content="+10" Width="35" Click="BtnMinionsAdd10_Click" Margin="2,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                                
                                <!-- Tavern Spells -->
                                <Grid Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Tavern Spells:" VerticalAlignment="Center" Foreground="White"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="-10" Width="35" Click="BtnTavernSpellsSub10_Click"/>
                                        <Button Content="-1" Width="30" Click="BtnTavernSpellsSub1_Click" Margin="2,0,0,0"/>
                                        <TextBlock x:Name="TxtTavernSpells" Text="0" Width="30" TextAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                                        <Button Content="+1" Width="30" Click="BtnTavernSpellsAdd1_Click" Margin="2,0,0,0"/>
                                        <Button Content="+10" Width="35" Click="BtnTavernSpellsAdd10_Click" Margin="2,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                                
                                <!-- Non-Tavern Spells -->
                                <Grid Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Non-Tavern Spells:" VerticalAlignment="Center" Foreground="White"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="-10" Width="35" Click="BtnNonTavernSpellsSub10_Click"/>
                                        <Button Content="-1" Width="30" Click="BtnNonTavernSpellsSub1_Click" Margin="2,0,0,0"/>
                                        <TextBlock x:Name="TxtNonTavernSpells" Text="0" Width="30" TextAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                                        <Button Content="+1" Width="30" Click="BtnNonTavernSpellsAdd1_Click" Margin="2,0,0,0"/>
                                        <Button Content="+10" Width="35" Click="BtnNonTavernSpellsAdd10_Click" Margin="2,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                                
                                <!-- Buy Minion -->
                                <Grid Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Buy Minion:" VerticalAlignment="Center" Foreground="White"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="-10" Width="35" Click="BtnBuyMinionSub10_Click"/>
                                        <Button Content="-1" Width="30" Click="BtnBuyMinionSub1_Click" Margin="2,0,0,0"/>
                                        <TextBlock x:Name="TxtBuyMinion" Text="0" Width="30" TextAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                                        <Button Content="+1" Width="30" Click="BtnBuyMinionAdd1_Click" Margin="2,0,0,0"/>
                                        <Button Content="+10" Width="35" Click="BtnBuyMinionAdd10_Click" Margin="2,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                                
                                <!-- Buy Spell -->
                                <Grid Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Buy Spell:" VerticalAlignment="Center" Foreground="White"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="-10" Width="35" Click="BtnBuySpellSub10_Click"/>
                                        <Button Content="-1" Width="30" Click="BtnBuySpellSub1_Click" Margin="2,0,0,0"/>
                                        <TextBlock x:Name="TxtBuySpell" Text="0" Width="30" TextAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                                        <Button Content="+1" Width="30" Click="BtnBuySpellAdd1_Click" Margin="2,0,0,0"/>
                                        <Button Content="+10" Width="35" Click="BtnBuySpellAdd10_Click" Margin="2,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                                
                                <!-- Sell Minion -->
                                <Grid Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Sell Minion:" VerticalAlignment="Center" Foreground="White"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="-10" Width="35" Click="BtnSellMinionSub10_Click"/>
                                        <Button Content="-1" Width="30" Click="BtnSellMinionSub1_Click" Margin="2,0,0,0"/>
                                        <TextBlock x:Name="TxtSellMinion" Text="0" Width="30" TextAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                                        <Button Content="+1" Width="30" Click="BtnSellMinionAdd1_Click" Margin="2,0,0,0"/>
                                        <Button Content="+10" Width="35" Click="BtnSellMinionAdd10_Click" Margin="2,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                                
                                <!-- Refresh -->
                                <Grid Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Refresh:" VerticalAlignment="Center" Foreground="White"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="-10" Width="35" Click="BtnRefreshSub10_Click"/>
                                        <Button Content="-1" Width="30" Click="BtnRefreshSub1_Click" Margin="2,0,0,0"/>
                                        <TextBlock x:Name="TxtRefresh" Text="0" Width="30" TextAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                                        <Button Content="+1" Width="30" Click="BtnRefreshAdd1_Click" Margin="2,0,0,0"/>
                                        <Button Content="+10" Width="35" Click="BtnRefreshAdd10_Click" Margin="2,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                                
                                <!-- Freeze -->
                                <Grid Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Freeze:" VerticalAlignment="Center" Foreground="White"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="-10" Width="35" Click="BtnFreezeSub10_Click"/>
                                        <Button Content="-1" Width="30" Click="BtnFreezeSub1_Click" Margin="2,0,0,0"/>
                                        <TextBlock x:Name="TxtFreeze" Text="0" Width="30" TextAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                                        <Button Content="+1" Width="30" Click="BtnFreezeAdd1_Click" Margin="2,0,0,0"/>
                                        <Button Content="+10" Width="35" Click="BtnFreezeAdd10_Click" Margin="2,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                                
                                <!-- Leveled Up -->
                                <Grid Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Leveled Up:" VerticalAlignment="Center" Foreground="White"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="-10" Width="35" Click="BtnLeveledUpSub10_Click"/>
                                        <Button Content="-1" Width="30" Click="BtnLeveledUpSub1_Click" Margin="2,0,0,0"/>
                                        <TextBlock x:Name="TxtLeveledUp" Text="0" Width="30" TextAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                                        <Button Content="+1" Width="30" Click="BtnLeveledUpAdd1_Click" Margin="2,0,0,0"/>
                                        <Button Content="+10" Width="35" Click="BtnLeveledUpAdd10_Click" Margin="2,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
