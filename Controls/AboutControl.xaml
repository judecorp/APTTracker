<Border
    x:Class="HDTPlugin.Controls.AboutControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#1A1A1A"
    BorderBrush="#AAAAAA"
    BorderThickness="1"
    Padding="8">

    <ScrollViewer x:Name="AboutScrollViewer" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,8,0,0">
            <TextBlock Text="About" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,16"/>
            
            <TextBlock Text="APT Tracker" FontSize="14" Foreground="White" Margin="0,0,0,8"/>
            <TextBlock Text="Version 1.0.0" FontSize="12" Foreground="#888888" Margin="0,0,0,8"/>
            <TextBlock Text="Created and maintained by JudeCorp. " FontSize="12" Foreground="#888888" TextWrapping="Wrap" Margin="0,0,0,16"/>
        </StackPanel>
    </ScrollViewer>
</Border>