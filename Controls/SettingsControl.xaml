<Border
    x:Class="APTTracker.Controls.SettingsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    mc:Ignorable="d"
    Background="#1A1A1A"
    BorderBrush="#AAAAAA"
    BorderThickness="1"
    Padding="8,0,0,0">

    <Border.Resources>
        <ResourceDictionary
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/ScrollBars.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="IconButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#333333"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Foreground" Value="#CCCCCC"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Background" Value="#333333"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Border.Resources>

    <ScrollViewer x:Name="SettingsScrollViewer" MaxHeight="300" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0" Padding="0,0,8,8">
        <StackPanel>
            <TextBlock Text="UI Scaling:" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Slider x:Name="ScaleSlider" Minimum="0.5" Maximum="2.0" Width="150" VerticalAlignment="Center"/>
                <TextBlock x:Name="ScaleValueText" Foreground="White" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            
            <Separator Background="#444444" Margin="0,4"/>

            <!-- Show Section header + Set All buttons (populated in code) -->
            <TextBlock Text="Show:" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,8"/>

            <StackPanel x:Name="AllButtonsPanel" Orientation="Vertical" HorizontalAlignment="Left"/>

            <!-- Show rows (Combat Time, Shop Time, APM, Rank) populated in code -->
            <StackPanel x:Name="ShowControlsPanel"/>

            <Separator Background="#444444" Margin="0,4"/>

            <!-- Individual counter rows populated in code -->
            <StackPanel x:Name="CounterControlsPanel"/>
        </StackPanel>
    </ScrollViewer>

</Border>
