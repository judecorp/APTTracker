<Border
    x:Class="HDTPlugin.Controls.SettingsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    mc:Ignorable="d"
    Background="#1A1A1A"
    BorderBrush="#AAAAAA"
    BorderThickness="1"
    Padding="8,0,0,0">

<Border.Resources>
        <ResourceDictionary
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

            <ResourceDictionary.MergedDictionaries>

                <ResourceDictionary Source="../Themes/ScrollBars.xaml"/>

            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="IconButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#333333"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>


        </ResourceDictionary>
        
    </Border.Resources>

    <ScrollViewer x:Name="SettingsScrollViewer" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
    <StackPanel>
        <!-- Show Section -->
        <TextBlock Text="Show:" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,8"/>

        <!-- Combat Time -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" Background="Transparent" Margin="0,2" Cursor="Hand" MouseLeftButtonDown="ShowToggle_Click" Tag="ShowCombatTime" MouseEnter="ShowToggle_MouseEnter" MouseLeave="ShowToggle_MouseLeave">
            <TextBlock x:Name="TextShowCombatTime" Text="Combat Time" Foreground="White" VerticalAlignment="Center"/>
            <iconPacks:PackIconMaterial x:Name="IconShowCombatTime" Kind="Check" Width="12" Height="12" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="#888888"/>
        </StackPanel>

        <!-- Shop Time -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" Background="Transparent" Margin="0,2" Cursor="Hand" MouseLeftButtonDown="ShowToggle_Click" Tag="ShowShopTime" MouseEnter="ShowToggle_MouseEnter" MouseLeave="ShowToggle_MouseLeave">
            <TextBlock x:Name="TextShowShopTime" Text="Shop Time" Foreground="White" VerticalAlignment="Center"/>
            <iconPacks:PackIconMaterial x:Name="IconShowShopTime" Kind="Check" Width="12" Height="12" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="#888888"/>
        </StackPanel>

        <!-- APM -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" Background="Transparent" Margin="0,2" Cursor="Hand" MouseLeftButtonDown="ShowToggle_Click" Tag="ShowAPM" MouseEnter="ShowToggle_MouseEnter" MouseLeave="ShowToggle_MouseLeave">
            <TextBlock x:Name="TextShowAPM" Text="APM" Foreground="White" VerticalAlignment="Center"/>
            <iconPacks:PackIconMaterial x:Name="IconShowAPM" Kind="Check" Width="12" Height="12" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="#888888"/>
        </StackPanel>

        <!-- Rank -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" Background="Transparent" Margin="0,2" Cursor="Hand" MouseLeftButtonDown="ShowToggle_Click" Tag="ShowRank" MouseEnter="ShowToggle_MouseEnter" MouseLeave="ShowToggle_MouseLeave">
            <TextBlock x:Name="TextShowRank" Text="Rank" Foreground="White" VerticalAlignment="Center"/>
            <iconPacks:PackIconMaterial x:Name="IconShowRank" Kind="Check" Width="12" Height="12" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="#888888"/>
        </StackPanel>

        <Separator Background="#444444" Margin="0,4"/>

        <!-- Individual Counter Section -->
        <TextBlock Text="Individual Counters:" FontSize="12" FontWeight="Bold" Foreground="White" Margin="0,4,0,4"/>

        <StackPanel x:Name="AllButtonsPanel" Orientation="Horizontal" Margin="0,0,0,8"/>

        <!-- Counter controls will be created dynamically -->
        <StackPanel x:Name="CounterControlsPanel"/>
    </StackPanel>
    </ScrollViewer>

</Border>