<Border
    x:Class="HDTPlugin.Controls.SettingsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    mc:Ignorable="d"
    Background="#1A1A1A"
    BorderBrush="#AAAAAA"
    BorderThickness="1"
    Padding="8">

    <Border.Resources>
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Border.Resources>

    <ScrollViewer x:Name="SettingsScrollViewer" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
        <StackPanel>
            <!-- Show Section -->
            <TextBlock Text="Show:" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,8"/>
            
            <!-- Combat Time -->
            <StackPanel Orientation="Horizontal" Margin="0,2" Cursor="Hand" MouseLeftButtonDown="ShowToggle_Click" Tag="ShowCombatTime" MouseEnter="ShowToggle_MouseEnter" MouseLeave="ShowToggle_MouseLeave">
                <TextBlock Text="Combat Time" Foreground="White" VerticalAlignment="Center"/>
                <iconPacks:PackIconMaterial x:Name="IconShowCombatTime" Kind="Check" Width="12" Height="12" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="#888888"/>
            </StackPanel>
            
            <!-- Shop Time -->
            <StackPanel Orientation="Horizontal" Margin="0,2" Cursor="Hand" MouseLeftButtonDown="ShowToggle_Click" Tag="ShowShopTime" MouseEnter="ShowToggle_MouseEnter" MouseLeave="ShowToggle_MouseLeave">
                <TextBlock Text="Shop Time" Foreground="White" VerticalAlignment="Center"/>
                <iconPacks:PackIconMaterial x:Name="IconShowShopTime" Kind="Check" Width="12" Height="12" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="#888888"/>
            </StackPanel>
            
            <!-- APM -->
            <StackPanel Orientation="Horizontal" Margin="0,2" Cursor="Hand" MouseLeftButtonDown="ShowToggle_Click" Tag="ShowAPM" MouseEnter="ShowToggle_MouseEnter" MouseLeave="ShowToggle_MouseLeave">
                <TextBlock Text="APM" Foreground="White" VerticalAlignment="Center"/>
                <iconPacks:PackIconMaterial x:Name="IconShowAPM" Kind="Check" Width="12" Height="12" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="#888888"/>
            </StackPanel>
            
            <!-- Rank -->
            <StackPanel Orientation="Horizontal" Margin="0,2" Cursor="Hand" MouseLeftButtonDown="ShowToggle_Click" Tag="ShowRank" MouseEnter="ShowToggle_MouseEnter" MouseLeave="ShowToggle_MouseLeave">
                <TextBlock Text="Rank" Foreground="White" VerticalAlignment="Center"/>
                <iconPacks:PackIconMaterial x:Name="IconShowRank" Kind="Check" Width="12" Height="12" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="#888888"/>
            </StackPanel>
            
            <Separator Background="#444444" Margin="0,4"/>
            
            <!-- Individual Counter Section -->
            <TextBlock Text="Individual Counters:" FontSize="12" FontWeight="Bold" Foreground="White" Margin="0,4,0,4"/>
            
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button x:Name="BtnAllAlways" FontSize="11" Padding="6,2" Margin="0,0,4,0" Click="BtnAllAlways_Click" MouseEnter="BtnAllAlways_MouseEnter" MouseLeave="BtnAllAlways_MouseLeave">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="All: Always" VerticalAlignment="Center" Foreground="#888888"/>
                        <iconPacks:PackIconMaterial Kind="Eye" Width="14" Height="14" Margin="4,0,0,0" VerticalAlignment="Center" Foreground="#888888"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnAllHover" FontSize="11" Padding="6,2" Margin="0,0,4,0" Click="BtnAllHover_Click" MouseEnter="BtnAllHover_MouseEnter" MouseLeave="BtnAllHover_MouseLeave">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="All: Hover" VerticalAlignment="Center" Foreground="#888888"/>
                        <iconPacks:PackIconMaterial Kind="CursorDefault" Width="14" Height="14" Margin="4,0,0,0" VerticalAlignment="Center" Foreground="#888888"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnAllNever" FontSize="11" Padding="6,2" Click="BtnAllNever_Click" MouseEnter="BtnAllNever_MouseEnter" MouseLeave="BtnAllNever_MouseLeave">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="All: Never" VerticalAlignment="Center" Foreground="#888888"/>
                        <iconPacks:PackIconMaterial Kind="Cancel" Width="14" Height="14" Margin="4,0,0,0" VerticalAlignment="Center" Foreground="#888888"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            
            <!-- Minions Played -->
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Minions Played" Foreground="White" VerticalAlignment="Center"/>
                <Button x:Name="BtnMinionsPlayedAlways" Grid.Column="1" Width="24" Height="24" Margin="2" Style="{StaticResource IconButtonStyle}" Click="BtnCounterAlways_Click" Tag="MinionsPlayed">
                    <iconPacks:PackIconMaterial Kind="Eye" Width="12" Height="12" Foreground="#888888"/>
                </Button>
                <Button x:Name="BtnMinionsPlayedHover" Grid.Column="2" Width="24" Height="24" Margin="2" Style="{StaticResource IconButtonStyle}" Click="BtnCounterHover_Click" Tag="MinionsPlayed">
                    <iconPacks:PackIconMaterial Kind="CursorDefault" Width="12" Height="12" Foreground="#888888"/>
                </Button>
                <Button x:Name="BtnMinionsPlayedNever" Grid.Column="3" Width="24" Height="24" Margin="2" Style="{StaticResource IconButtonStyle}" Click="BtnCounterNever_Click" Tag="MinionsPlayed">
                    <iconPacks:PackIconMaterial Kind="Cancel" Width="12" Height="12" Foreground="#888888"/>
                </Button>
            </Grid>
            
            <!-- Tavern Spells -->
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Tavern Spells" Foreground="White" VerticalAlignment="Center"/>
                <Button x:Name="BtnTavernSpellsAlways" Grid.Column="1" Width="24" Height="24" Margin="2" Style="{StaticResource IconButtonStyle}" Click="BtnCounterAlways_Click" Tag="TavernSpells">
                    <iconPacks:PackIconMaterial Kind="Eye" Width="12" Height="12" Foreground="#888888"/>
                </Button>
                <Button x:Name="BtnTavernSpellsHover" Grid.Column="2" Width="24" Height="24" Margin="2" Style="{StaticResource IconButtonStyle}" Click="BtnCounterHover_Click" Tag="TavernSpells">
                    <iconPacks:PackIconMaterial Kind="CursorDefault" Width="12" Height="12" Foreground="#888888"/>
                </Button>
                <Button x:Name="BtnTavernSpellsNever" Grid.Column="3" Width="24" Height="24" Margin="2" Style="{StaticResource IconButtonStyle}" Click="BtnCounterNever_Click" Tag="TavernSpells">
                    <iconPacks:PackIconMaterial Kind="Cancel" Width="12" Height="12" Foreground="#888888"/>
                </Button>
            </Grid>
            
            <!-- Non-Tavern Spells -->
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Non-Tavern Spells" Foreground="White" VerticalAlignment="Center"/>
                <Button x:Name="BtnNonTavernSpellsAlways" Grid.Column="1" Width="24" Height="24" Margin="2" Style="{StaticResource IconButtonStyle}" Click="BtnCounterAlways_Click" Tag="NonTavernSpells">
                    <iconPacks:PackIconMaterial Kind="Eye" Width="12" Height="12" Foreground="#888888"/>
                </Button>
                <Button x:Name="BtnNonTavernSpellsHover" Grid.Column="2" Width="24" Height="24" Margin="2" Style="{StaticResource IconButtonStyle}" Click="BtnCounterHover_Click" Tag="NonTavernSpells">
                    <iconPacks:PackIconMaterial Kind="CursorDefault" Width="12" Height="12" Foreground="#888888"/>
                </Button>
                <Button x:Name="BtnNonTavernSpellsNever" Grid.Column="3" Width="24" Height="24" Margin="2" Style="{StaticResource IconButtonStyle}" Click="BtnCounterNever_Click" Tag="NonTavernSpells">
                    <iconPacks:PackIconMaterial Kind="Cancel" Width="12" Height="12" Foreground="#888888"/>
                </Button>
            </Grid>
            
            <!-- Cards Bought -->
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Cards Bought" Foreground="White" VerticalAlignment="Center"/>
                <Button x:Name="BtnCardsBoughtAlways" Grid.Column="1" Width="24" Height="24" Margin="2" Style="{StaticResource IconButtonStyle}" Click="BtnCounterAlways_Click" Tag="CardsBought">
                    <iconPacks:PackIconMaterial Kind="Eye" Width="12" Height="12" Foreground="#888888"/>
                </Button>
                <Button x:Name="BtnCardsBoughtHover" Grid.Column="2" Width="24" Height="24" Margin="2" Style="{StaticResource IconButtonStyle}" Click="BtnCounterHover_Click" Tag="CardsBought">
                    <iconPacks:PackIconMaterial Kind="CursorDefault" Width="12" Height="12" Foreground="#888888"/>
                </Button>
                <Button x:Name="BtnCardsBoughtNever" Grid.Column="3" Width="24" Height="24" Margin="2" Style="{StaticResource IconButtonStyle}" Click="BtnCounterNever_Click" Tag="CardsBought">
                    <iconPacks:PackIconMaterial Kind="Cancel" Width="12" Height="12" Foreground="#888888"/>
                </Button>
            </Grid>
            
            <!-- Sell Minion -->
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Sell Minion" Foreground="White" VerticalAlignment="Center"/>
                <Button x:Name="BtnSellMinionAlways" Grid.Column="1" Width="24" Height="24" Margin="2" Style="{StaticResource IconButtonStyle}" Click="BtnCounterAlways_Click" Tag="SellMinion">
                    <iconPacks:PackIconMaterial Kind="Eye" Width="12" Height="12" Foreground="#888888"/>
                </Button>
                <Button x:Name="BtnSellMinionHover" Grid.Column="2" Width="24" Height="24" Margin="2" Style="{StaticResource IconButtonStyle}" Click="BtnCounterHover_Click" Tag="SellMinion">
                    <iconPacks:PackIconMaterial Kind="CursorDefault" Width="12" Height="12" Foreground="#888888"/>
                </Button>
                <Button x:Name="BtnSellMinionNever" Grid.Column="3" Width="24" Height="24" Margin="2" Style="{StaticResource IconButtonStyle}" Click="BtnCounterNever_Click" Tag="SellMinion">
                    <iconPacks:PackIconMaterial Kind="Cancel" Width="12" Height="12" Foreground="#888888"/>
                </Button>
            </Grid>
            
            <!-- Refresh -->
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Refresh" Foreground="White" VerticalAlignment="Center"/>
                <Button x:Name="BtnRefreshAlways" Grid.Column="1" Width="24" Height="24" Margin="2" Style="{StaticResource IconButtonStyle}" Click="BtnCounterAlways_Click" Tag="Refresh">
                    <iconPacks:PackIconMaterial Kind="Eye" Width="12" Height="12" Foreground="#888888"/>
                </Button>
                <Button x:Name="BtnRefreshHover" Grid.Column="2" Width="24" Height="24" Margin="2" Style="{StaticResource IconButtonStyle}" Click="BtnCounterHover_Click" Tag="Refresh">
                    <iconPacks:PackIconMaterial Kind="CursorDefault" Width="12" Height="12" Foreground="#888888"/>
                </Button>
                <Button x:Name="BtnRefreshNever" Grid.Column="3" Width="24" Height="24" Margin="2" Style="{StaticResource IconButtonStyle}" Click="BtnCounterNever_Click" Tag="Refresh">
                    <iconPacks:PackIconMaterial Kind="Cancel" Width="12" Height="12" Foreground="#888888"/>
                </Button>
            </Grid>
            
            <!-- Freeze -->
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Freeze" Foreground="White" VerticalAlignment="Center"/>
                <Button x:Name="BtnFreezeAlways" Grid.Column="1" Width="24" Height="24" Margin="2" Style="{StaticResource IconButtonStyle}" Click="BtnCounterAlways_Click" Tag="Freeze">
                    <iconPacks:PackIconMaterial Kind="Eye" Width="12" Height="12" Foreground="#888888"/>
                </Button>
                <Button x:Name="BtnFreezeHover" Grid.Column="2" Width="24" Height="24" Margin="2" Style="{StaticResource IconButtonStyle}" Click="BtnCounterHover_Click" Tag="Freeze">
                    <iconPacks:PackIconMaterial Kind="CursorDefault" Width="12" Height="12" Foreground="#888888"/>
                </Button>
                <Button x:Name="BtnFreezeNever" Grid.Column="3" Width="24" Height="24" Margin="2" Style="{StaticResource IconButtonStyle}" Click="BtnCounterNever_Click" Tag="Freeze">
                    <iconPacks:PackIconMaterial Kind="Cancel" Width="12" Height="12" Foreground="#888888"/>
                </Button>
            </Grid>
            
            <!-- Leveled Up -->
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Leveled Up" Foreground="White" VerticalAlignment="Center"/>
                <Button x:Name="BtnLeveledUpAlways" Grid.Column="1" Width="24" Height="24" Margin="2" Style="{StaticResource IconButtonStyle}" Click="BtnCounterAlways_Click" Tag="LeveledUp">
                    <iconPacks:PackIconMaterial Kind="Eye" Width="12" Height="12" Foreground="#888888"/>
                </Button>
                <Button x:Name="BtnLeveledUpHover" Grid.Column="2" Width="24" Height="24" Margin="2" Style="{StaticResource IconButtonStyle}" Click="BtnCounterHover_Click" Tag="LeveledUp">
                    <iconPacks:PackIconMaterial Kind="CursorDefault" Width="12" Height="12" Foreground="#888888"/>
                </Button>
                <Button x:Name="BtnLeveledUpNever" Grid.Column="3" Width="24" Height="24" Margin="2" Style="{StaticResource IconButtonStyle}" Click="BtnCounterNever_Click" Tag="LeveledUp">
                    <iconPacks:PackIconMaterial Kind="Cancel" Width="12" Height="12" Foreground="#888888"/>
                </Button>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Border>