<Border
    x:Class="HDTPlugin.Controls.SettingsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    mc:Ignorable="d"
    Background="#1A1A1A"
    BorderBrush="#AAAAAA"
    BorderThickness="1"
    Padding="8">

    <Border.Resources>
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Border.Resources>

    <ScrollViewer x:Name="SettingsScrollViewer" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
        <StackPanel>
            <!-- Show Section -->
            <TextBlock Text="Show:" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,8"/>
            
            <!-- Combat Time -->
            <StackPanel Orientation="Horizontal" Margin="0,2" Cursor="Hand" MouseLeftButtonDown="ShowToggle_Click" Tag="ShowCombatTime" MouseEnter="ShowToggle_MouseEnter" MouseLeave="ShowToggle_MouseLeave">
                <TextBlock Text="Combat Time" Foreground="White" VerticalAlignment="Center"/>
                <iconPacks:PackIconMaterial x:Name="IconShowCombatTime" Kind="Check" Width="12" Height="12" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="#888888"/>
            </StackPanel>
            
            <!-- Shop Time -->
            <StackPanel Orientation="Horizontal" Margin="0,2" Cursor="Hand" MouseLeftButtonDown="ShowToggle_Click" Tag="ShowShopTime" MouseEnter="ShowToggle_MouseEnter" MouseLeave="ShowToggle_MouseLeave">
                <TextBlock Text="Shop Time" Foreground="White" VerticalAlignment="Center"/>
                <iconPacks:PackIconMaterial x:Name="IconShowShopTime" Kind="Check" Width="12" Height="12" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="#888888"/>
            </StackPanel>
            
            <!-- APM -->
            <StackPanel Orientation="Horizontal" Margin="0,2" Cursor="Hand" MouseLeftButtonDown="ShowToggle_Click" Tag="ShowAPM" MouseEnter="ShowToggle_MouseEnter" MouseLeave="ShowToggle_MouseLeave">
                <TextBlock Text="APM" Foreground="White" VerticalAlignment="Center"/>
                <iconPacks:PackIconMaterial x:Name="IconShowAPM" Kind="Check" Width="12" Height="12" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="#888888"/>
            </StackPanel>
            
            <!-- Rank -->
            <StackPanel Orientation="Horizontal" Margin="0,2" Cursor="Hand" MouseLeftButtonDown="ShowToggle_Click" Tag="ShowRank" MouseEnter="ShowToggle_MouseEnter" MouseLeave="ShowToggle_MouseLeave">
                <TextBlock Text="Rank" Foreground="White" VerticalAlignment="Center"/>
                <iconPacks:PackIconMaterial x:Name="IconShowRank" Kind="Check" Width="12" Height="12" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="#888888"/>
            </StackPanel>
            
            <Separator Background="#444444" Margin="0,4"/>
            
            <!-- Individual Counter Section -->
            <TextBlock Text="Individual Counters:" FontSize="12" FontWeight="Bold" Foreground="White" Margin="0,4,0,4"/>
            
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button x:Name="BtnAllAlways" FontSize="11" Padding="6,2" Margin="0,0,4,0" Click="BtnAllAlways_Click" MouseEnter="BtnAllAlways_MouseEnter" MouseLeave="BtnAllAlways_MouseLeave">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="All: Always" VerticalAlignment="Center" Foreground="#888888"/>
                        <iconPacks:PackIconMaterial Kind="Eye" Width="14" Height="14" Margin="4,0,0,0" VerticalAlignment="Center" Foreground="#888888"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnAllHover" FontSize="11" Padding="6,2" Margin="0,0,4,0" Click="BtnAllHover_Click" MouseEnter="BtnAllHover_MouseEnter" MouseLeave="BtnAllHover_MouseLeave">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="All: Hover" VerticalAlignment="Center" Foreground="#888888"/>
                        <iconPacks:PackIconMaterial Kind="CursorDefault" Width="14" Height="14" Margin="4,0,0,0" VerticalAlignment="Center" Foreground="#888888"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnAllNever" FontSize="11" Padding="6,2" Click="BtnAllNever_Click" MouseEnter="BtnAllNever_MouseEnter" MouseLeave="BtnAllNever_MouseLeave">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="All: Never" VerticalAlignment="Center" Foreground="#888888"/>
                        <iconPacks:PackIconMaterial Kind="Cancel" Width="14" Height="14" Margin="4,0,0,0" VerticalAlignment="Center" Foreground="#888888"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            
            <!-- Counter controls will be created dynamically -->
            <StackPanel x:Name="CounterControlsPanel"/>
        </StackPanel>
    </ScrollViewer>
</Border>