<Grid
    x:Class="HDTPlugin.Controls.PluginContainer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="clr-namespace:HDTPlugin.Controls"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    mc:Ignorable="d"
    MinWidth="225">

    <Grid.Resources>
        <Style x:Key="HeaderButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Grid.Resources>

    <Grid>
        <!-- Main Content Area -->
        <controls:PlugInDisplayControl x:Name="DisplayPanel"/>
        <controls:SettingsControl x:Name="SettingsPanel" Visibility="Collapsed"/>
        <controls:AchievementsControl x:Name="AchievementsPanel" Visibility="Collapsed"/>
        <controls:AboutControl x:Name="AboutPanel" Visibility="Collapsed"/>
        
        <!-- Navigation Buttons Overlay (always visible) -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,4,0" Panel.ZIndex="100">
            <Button x:Name="AboutButton" Click="AboutButton_Click" Style="{StaticResource HeaderButtonStyle}" Margin="0,0,4,0" MouseEnter="HeaderButton_MouseEnter" MouseLeave="HeaderButton_MouseLeave" Tag="HelpIcon">
                <iconPacks:PackIconMaterial x:Name="HelpIcon" Kind="HelpCircle" Foreground="#888888"/>
            </Button>
            <Button x:Name="AchievementsButton" Click="AchievementsButton_Click" Style="{StaticResource HeaderButtonStyle}" Margin="0,0,4,0" MouseEnter="HeaderButton_MouseEnter" MouseLeave="HeaderButton_MouseLeave" Tag="TrophyIcon">
                <iconPacks:PackIconMaterial x:Name="TrophyIcon" Kind="Trophy" Foreground="#888888"/>
            </Button>
            <Button x:Name="SettingsButton" Click="SettingsButton_Click" Style="{StaticResource HeaderButtonStyle}" Margin="0" MouseEnter="HeaderButton_MouseEnter" MouseLeave="HeaderButton_MouseLeave" Tag="SettingsIcon">
                <iconPacks:PackIconMaterial x:Name="SettingsIcon" Kind="Cog" Foreground="#888888"/>
            </Button>
        </StackPanel>
        
        <!-- Back Button (visible when in any non-display mode) -->
        <Button x:Name="BackButton" Click="BackButton_Click" Style="{StaticResource HeaderButtonStyle}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4,2,0,0" Panel.ZIndex="100" Visibility="Collapsed" MouseEnter="HeaderButton_MouseEnter" MouseLeave="HeaderButton_MouseLeave" Tag="BackIcon">
            <iconPacks:PackIconMaterial x:Name="BackIcon" Kind="ArrowLeft" Foreground="#888888"/>
        </Button>
    </Grid>
</Grid>