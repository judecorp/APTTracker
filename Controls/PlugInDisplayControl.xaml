<StackPanel
    x:Class="HDTPlugin.Controls.PlugInDisplayControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    MinWidth="340"
    d:DesignHeight="400" d:DesignWidth="340">
    
    <!-- Summary Panel -->
    <Border
        x:Name="SummaryBorder"
        Background="#1A1A1A"
        BorderBrush="#AAAAAA"
        BorderThickness="1"
        Padding="8,4,8,8">
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Top: Rank Label (header) -->
            <TextBlock
                x:Name="RankLabel"
                Grid.Row="0"
                FontSize="20"
                FontWeight="Bold"
                Foreground="White"
                Text="Rank: Barely Awake"
                Margin="0,0,0,0"/>
            
            <!-- Bottom: Two columns -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Left: Rank Image -->
                <Border
                    x:Name="RankBorder"
                    Grid.Column="0"
                    Width="140"
                    Height="140"
                    Background="#CD7F32"
                    CornerRadius="8"
                    Margin="0,0,8,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"/>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Total Actions Counter -->
                    <Border x:Name="CounterBorder" Grid.Row="0" Width="120" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <TextBlock
                            x:Name="SummaryCounter"
                            FontSize="56"
                            FontWeight="UltraBold"
                            Foreground="White"
                            Margin="0,-8,0,0"
                            Text="41"
                            TextAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Row="1" >
                        <!-- Turn Length -->
                        <StackPanel x:Name="TurnLengthPanel" Orientation="Horizontal" HorizontalAlignment="Center"  VerticalAlignment="Bottom" Margin="0,0,0,0">
                            <TextBlock x:Name="TurnLengthLabel" FontSize="20" FontWeight="Bold" Foreground="White" Text="Turn Length: "/>
                            <TextBlock x:Name="TurnLengthText" FontSize="20" FontWeight="Bold" Foreground="White" Text="120s"/>
                        </StackPanel>

                        <!-- APM -->
                        <StackPanel x:Name="ApmPanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,0">
                            <TextBlock x:Name="ApmLabel" FontSize="20" FontWeight="Bold" Foreground="White" Text="APM: "/>
                            <TextBlock x:Name="ApmText" FontSize="20" FontWeight="Bold" Foreground="White" Text="2.13"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
    
    <!-- Counters Panel -->
    <Border
        x:Name="CountersBorder"
        Background="#1A1A1A"
        Padding="8,8,8,8"
        Margin="0,0,0,0">
        
        <StackPanel>
            <TextBlock x:Name="UnitsText" FontSize="18" Foreground="White" Text="Minions Played: 0" TextAlignment="Center" Margin="0,4,0,0"/>
            <TextBlock x:Name="TavernSpellsText" FontSize="18" Foreground="White" Text="Tavern Spells: 0" TextAlignment="Center" Margin="0,4,0,0"/>
            <TextBlock x:Name="NonTavernSpellsText" FontSize="18" Foreground="White" Text="Non-Tavern Spells: 0" TextAlignment="Center" Margin="0,4,0,0"/>
            <TextBlock x:Name="CardsBoughtText" FontSize="18" Foreground="#4CAF50" Text="Cards Bought: 0" TextAlignment="Center" Margin="0,4,0,0"/>
            <TextBlock x:Name="SellMinionText" FontSize="18" Foreground="#F44336" Text="Sell Minion: 0" TextAlignment="Center" Margin="0,4,0,0"/>
            <TextBlock x:Name="RefreshText" FontSize="18" Foreground="#2196F3" Text="Refresh: 0" TextAlignment="Center" Margin="0,4,0,0"/>
            <TextBlock x:Name="FreezeText" FontSize="18" Foreground="#9C27B0" Text="Freeze: 0" TextAlignment="Center" Margin="0,4,0,0"/>
            <TextBlock x:Name="TavernTierText" FontSize="18" Foreground="#FFD700" Text="Leveled Up: 0" TextAlignment="Center" Margin="0,4,0,0"/>
        </StackPanel>
    </Border>
</StackPanel>