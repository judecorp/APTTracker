<StackPanel
    x:Class="HDTPlugin.Controls.PlugInDisplayControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    MinWidth="225"
    d:DesignHeight="400" d:DesignWidth="225"
    MouseLeave="Plugin_MouseLeave">
    
    <!-- Summary Panel -->
    <Border
        x:Name="SummaryBorder"
        Background="#1A1A1A"
        BorderBrush="#AAAAAA"
        BorderThickness="1"
        Padding="8,4,8,8"
        MouseEnter="SummaryBorder_MouseEnter"
        MouseLeave="SummaryBorder_MouseLeave">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top: Rank Label (header) -->
            <TextBlock
                x:Name="RankLabel"
                Grid.Row="0"
                FontSize="14"
                FontWeight="Bold"
                Foreground="White"
                Text="Rank: Barely Awake"
                Margin="0,-8,0,0"/>

            <!-- Bottom: Two columns -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Rank Image -->
                <Image
                    x:Name="RankImage"
                    Grid.Column="0"
                    Width="80"
                    Height="80"
                    Margin="0,0,8,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Stretch="Uniform"/>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Total Actions Counter -->
                    <Border x:Name="CounterBorder" Grid.Row="0" MinWidth="90" Height="40" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <TextBlock
                            x:Name="SummaryCounter"
                            FontSize="42"
                            FontWeight="UltraBold"
                            Foreground="White"
                            Margin="0,-16,0,-8"
                            Text="41"
                            TextAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Row="1" >
                        <!-- C/S Time -->
                        <StackPanel x:Name="CombatShopTimePanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,0">
                            <TextBlock x:Name="CombatShopTimeLabel" FontSize="14" FontWeight="Bold" Foreground="White" Text="Turn: "/>
                            <TextBlock x:Name="CombatTimeText" FontSize="14" FontWeight="Bold" Foreground="#E91E63" Text="10s"/>
                            <TextBlock x:Name="CombatShopSlash" FontSize="14" FontWeight="Bold" Foreground="White" Text="/"/>
                            <TextBlock x:Name="ShopTimeText" FontSize="14" FontWeight="Bold" Foreground="#FF9800" Text="121s"/>
                        </StackPanel>
                        <!-- APM -->
                        <StackPanel x:Name="ApmPanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,0">
                            <TextBlock x:Name="ApmLabel" FontSize="14" FontWeight="Bold" Foreground="White" Text="APM: "/>
                            <TextBlock x:Name="ApmText" FontSize="14" FontWeight="Bold" Foreground="White" Text="2.13"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
    
    <!-- Counters Panel -->
    <Border
        x:Name="CountersBorder"
        Background="#1A1A1A"
        BorderBrush="#AAAAAA"
        BorderThickness="1,0,1,1"
        Padding="8"
        Visibility="Collapsed">
        
        <StackPanel>
            <TextBlock x:Name="UnitsText" FontSize="14" Foreground="White" Text="Minions Played: 0" TextAlignment="Center" Margin="0"/>
            <TextBlock x:Name="TavernSpellsText" FontSize="14" Foreground="White" Text="Tavern Spells: 0" TextAlignment="Center" Margin="0"/>
            <TextBlock x:Name="NonTavernSpellsText" FontSize="14" Foreground="White" Text="Non-Tavern Spells: 0" TextAlignment="Center" Margin="0"/>
            <TextBlock x:Name="CardsBoughtText" FontSize="14" Foreground="#4CAF50" Text="Cards Bought: 0" TextAlignment="Center" Margin="0"/>
            <TextBlock x:Name="SellMinionText" FontSize="14" Foreground="#F44336" Text="Sell Minion: 0" TextAlignment="Center" Margin="0"/>
            <TextBlock x:Name="RefreshText" FontSize="14" Foreground="#2196F3" Text="Refresh: 0" TextAlignment="Center" Margin="0"/>
            <TextBlock x:Name="FreezeText" FontSize="14" Foreground="#9C27B0" Text="Freeze: 0" TextAlignment="Center" Margin="0"/>
            <TextBlock x:Name="TavernTierText" FontSize="14" Foreground="#FFD700" Text="Leveled Up: 0" TextAlignment="Center" Margin="0"/>
        </StackPanel>
    </Border>
</StackPanel>