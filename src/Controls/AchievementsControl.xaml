<Border
    x:Class="APTTracker.Controls.AchievementsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    mc:Ignorable="d"
    Background="#1A1A1A"
    BorderBrush="#AAAAAA"
    BorderThickness="1"
    Padding="8">

    <ScrollViewer x:Name="AchievementsScrollViewer" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,8,0,0">
            <TextBlock Text="Highest APT:" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <iconPacks:PackIconMaterial Kind="Trophy" Height="10" Foreground="Gold" VerticalAlignment="Bottom" Margin="0,0,0,10"/>
                <TextBlock x:Name="HighestAptTextBlock" Text="0" 
                            FontSize="42"
                            FontWeight="UltraBold"
                            Foreground="White" Margin="0,0,0,0"/>
                <iconPacks:PackIconMaterial Kind="Trophy" Height="10" Foreground="Gold" VerticalAlignment="Bottom" Margin="0,0,0,10"/>
            </StackPanel>
            <Image x:Name="HighestRankImage"
                   Width="80"
                   Height="80"
                   HorizontalAlignment="Center"
                   Stretch="Uniform"
                   Margin="0,4,0,4"/>
            <TextBlock x:Name="HighestRankName"
                       FontSize="14"
                       FontWeight="Bold"
                       Foreground="White"
                       TextAlignment="Center"
                       TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
</Border>
